<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.tnfx1.PrivaVault</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>PrivaVault</name>
  <summary>Lock files into password-protected vaults</summary>
  <summary xml:lang="tr">Dosyaları parolalı kasalara kilitleyin</summary>
  <developer id="io.github.tnfx1">
    <name>TNFX1</name>
  </developer>
  <description>
    <p>PrivaVault locks files and folders into a single encrypted vault file on your own computer.
    It works fully offline: no account, no cloud, no telemetry.</p>
    <ul>
      <li>Unlocking lists the contents instantly; save one file, extract everything, or export a ZIP</li>
      <li>scrypt key derivation and AES-256-GCM in authenticated chunks</li>
      <li>Edited, truncated or damaged vaults are detected before any data is written</li>
      <li>Nothing decrypted is written to temporary folders</li>
      <li>Vaults lock themselves after a period of inactivity</li>
      <li>Opens vaults made by PrivaVault 1.x</li>
    </ul>
    <p>There is no password recovery: without the password, nobody can open a vault.</p>
    <p xml:lang="tr">PrivaVault, dosya ve klasörlerinizi kendi bilgisayarınızda tek bir şifreli kasa dosyasına
    kilitler. Tamamen çevrimdışı çalışır: hesap, bulut ve telemetri yoktur.</p>
  </description>
  <launchable type="desktop-id">io.github.tnfx1.PrivaVault.desktop</launchable>
