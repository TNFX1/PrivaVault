{
  "name": "ghostvault",
  "version": "1.2.19",
  "description": "Secure Local Stream Encryption Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win -p always"
  },
  "keywords": [],
  "author": "TNFX1",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "node-stream-zip": "^1.15.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tnfx1.ghostvault",
    "productName": "PrivaVault",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "TNFX1",
      "repo": "GhostVault"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}