{
  "name": "privavault",
  "version": "1.3.5",
  "description": "Secure Local Stream Encryption Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win -p always"
  },
  "keywords": [],
  "author": "TNFX1",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "node-stream-zip": "^1.15.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tnfx1.privavault",
    "productName": "PrivaVault",
    "generateUpdatesFilesForAllChannels": false,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "TNFX1",
      "repo": "PrivaVault",
      "releaseType": "release"
    },
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}