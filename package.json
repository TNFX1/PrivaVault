{
  "name": "privavault",
  "version": "1.2.1",
  "description": "Secure Local Encryption Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish always"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.privavault.app",
    "productName": "PrivaVault",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TNFX1",
        "repo": "GhostVault",
        "releaseType": "release"
      }
    ]
  }
}