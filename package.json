{
  "name": "privavault",
  "version": "1.4.0",
  "description": "Modern, ultra-secure & zero-knowledge desktop file encryption app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "encryption",
    "security",
    "electron",
    "aes-256-gcm",
    "zero-knowledge",
    "vault"
  ],
  "author": {
    "name": "TNFX1",
    "email": "contact@privavault.app"
  },
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.2",
    "node-stream-zip": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.privavault.app",
    "productName": "PrivaVault",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PrivaVault-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PrivaVault-Portable-${version}.${ext}"
    }
  }
}