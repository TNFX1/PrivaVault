{
  "name": "privavault",
  "version": "1.3.6",
  "description": "Modern, ultra-secure & zero-knowledge desktop file encryption app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage deb rpm pacman",
    "build:all": "electron-builder -wl"
  },
  "keywords": [
    "encryption",
    "security",
    "electron",
    "aes-256-gcm",
    "zero-knowledge",
    "vault"
  ],
  "author": {
    "name": "TNFX1",
    "email": "contact@privavault.app"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.privavault.app",
    "productName": "PrivaVault",
    "generateUpdatesFilesForAllChannels": false,
    "publish": {
      "provider": "github",
      "owner": "TNFX1",
      "repo": "PrivaVault"
    },
    "files": [
      "**/*",
      "!assets/preview.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Utility",
      "maintainer": "TNFX1 <contact@privavault.app>",
      "icon": "assets/logo.png",
      "synopsis": "Zero-Knowledge Desktop File Encryption Application",
      "description": "PrivaVault is a high-performance, local stream encryption desktop application using AES-256-GCM and PBKDF2.",
      "desktop": {
        "StartupWMClass": "PrivaVault"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}